# Copy this file to .env and fill in the values. Never commit .env.

# Nebius Token Factory (OpenAI-compatible API)
NEBIUS_API_KEY=
# Optional: leave empty to use the base URL in config.yaml
NEBIUS_BASE_URL=

# Tavily search API
TAVILY_API_KEY=

# Where Duly keeps your documents, memory and placeholders (default: data/user in this folder)
DULY_DATA_DIR=

# Public demo only (optional; defaults are in config.yaml)
DEMO_DAILY_BUDGET_USD=
DEMO_TOTAL_BUDGET_USD=
DEMO_TAVILY_DAILY_CREDITS=
DEMO_TAVILY_TOTAL_CREDITS=
# Set to 1 on the hosted demo: every visitor gets a private, temporary copy of the sample data
DULY_DEMO_MODE=
